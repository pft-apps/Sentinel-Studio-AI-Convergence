{
  "name": "sentinel-studio-executive",
  "version": "2.5.0",
  "description": "Sentinel Studio Executive Workstation & Multi-AI Knowledge OS",
  "main": "main.js",
  "author": "Patrick Jay F. Tanap, CPA, CICA",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "electron": "electron .",
    "pack": "electron-builder --dir --win --x64",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.filinvest.sentinel.studio",
    "productName": "Sentinel Studio",
    "win": {
      "target": "dir"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "index.html"
    ],
    "directories": {
      "output": "dist-electron"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@litert-lm/core": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "marked": "^18.1.1",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "turndown": "^7.2.4",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
